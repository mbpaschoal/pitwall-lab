+LIMITE, INTERVALO_MINIMO, TENTATIVAS = 100, 8.0, 2
+UA = 'PitwallLab/operacao-2026 (educational portfolio; sequential cache client)'
+_ENDPOINTS = frozenset(('calendario', 'resultados', 'classificacao'))
