+class Operacao2026R2Test(unittest.TestCase):
+    def setUp(self):
+        SCRATCH.mkdir(parents=True, exist_ok=True)
+        self.temp = tempfile.TemporaryDirectory(dir=str(SCRATCH))
+        self.root = Path(self.temp.name)
+        self.snapshots = self.root / 'snapshots'
