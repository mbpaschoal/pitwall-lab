+RACE_START = datetime(2026, 10, 25, 20, tzinfo=timezone.utc)
+FAKE_GIT = {'commit': 'synthetic-not-a-commit', 'componentes_rastreados': True,
+            'componentes_limpos': True, 'sha256': {}}
