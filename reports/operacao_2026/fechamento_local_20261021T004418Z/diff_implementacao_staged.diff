+        if key[0] != '2026' or not isinstance(circuit, str) or not circuit: raise ValueError
+        return key, circuit
+    except (KeyError, TypeError, ValueError) as error:
+        raise ValueError('Corrida/data/hora UTC inválida.') from error
+
